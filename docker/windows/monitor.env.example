# Helpdesk Production monitoring and backup configuration (Windows Docker Desktop).
# Copy to a folder only the service account and administrators can read (for example C:\ProgramData\Helpdesk\monitor.env), then edit.
# This file may contain a secret URL (ntfy topic, Healthchecks ping URL): never commit it, never paste it into tickets or chat.
# Used by scripts\windows\watchdog-production.ps1, backup-production.ps1 and install-production-tasks.ps1. Guide: docs\guides\WINDOWS_MONITORING_AND_BACKUP.md

# ---- alerts (required for the watchdog) -------------------------------------------------------------------------------------------------------------
# HTTPS endpoint that receives alerts. ntfy: https://ntfy.example.com/<your-secret-topic> (self-hosted or ntfy.sh). Any HTTPS endpoint works with the json format.
ALERT_WEBHOOK_URL=
# ntfy (default: text body, Title/Priority/Tags headers) or json ({title,message,priority,tags,status,key,host})
ALERT_WEBHOOK_FORMAT=ntfy
# Optional file holding a bearer token for the endpoint (one line, ACL-restricted). Never put the token itself here.
ALERT_WEBHOOK_TOKEN_FILE=

# ---- dead-man heartbeat (optional, recommended) -----------------------------------------------------------------------------------------------------
# Pinged after every completed watchdog run. An external service (Healthchecks-compatible) alerts when pings STOP, which is the only signal that works when the whole PC is down.
HEARTBEAT_URL=

# ---- backups ----------------------------------------------------------------------------------------------------------------------------------------
# Absolute path (the scheduled account's profile is not yours): where verified backups and last-backup.json are written.
BACKUP_DIR=
# File holding the backup passphrase (one line). ACL: the service account and administrators only. Never inside BACKUP_DIR or the repository.
BACKUP_PASSPHRASE_FILE=
# REQUIRED off-host destinations, semicolon-separated. Local drive or UNC share, for example \\nas\helpdesk-backups\prod . A missing destination fails the backup and alerts.
BACKUP_REQUIRED_DIRS=
# Optional extra local copies (a USB disk). A missing one only warns.
BACKUP_COPY_DIRS=
# Retention (14 days and the 24 newest verified sets) always applies to BACKUP_DIR. Set true to apply it to the destinations as well.
BACKUP_PRUNE_DESTINATIONS=false

# ---- thresholds (defaults shown; only change with the owner's approval) ---------------------------------------------------------------------------
MONITOR_BACKUP_MAX_AGE_MINUTES=120
MONITOR_MAIL_SYNC_STALE_MINUTES=15
MONITOR_CONFIRM_RUNS=2
MONITOR_REMINDER_MINUTES=360
MONITOR_COMMAND_TIMEOUT_SECONDS=20
MONITOR_BOOT_GRACE_MINUTES=10
MONITOR_MIN_FREE_DISK_GB=10
# Folder for the alert state and watchdog.log. Default: %ProgramData%\Helpdesk\monitor
MONITOR_STATE_DIR=

# ---- stack (defaults match the standard Compose project) ----------------------------------------------------------------------------------------------
PG_CONTAINER=helpdesk-postgres-prod-1
APP_CONTAINER=helpdesk-backend
OBJECTSTORE_CONTAINER=helpdesk-objectstore-prod-1

# ---- credential expiry (warnings at 30, 14 and 7 days, then expired) -----------------------------------------------------------------------------------
# Expiry date of the Microsoft Entra sign-in client secret (yyyy-MM-dd). Read it in the Entra admin centre when you create the secret; update it on every rotation.
ENTRA_SECRET_EXPIRES=
# Certificate files to watch, semicolon-separated. A .cer/.crt needs no password; a .pfx is written as <file>|<password-file>.
CERT_EXPIRY_FILES=
EXPIRY_WARN_DAYS=30;14;7
