# Windows Docker Desktop environment. Copy to docker\windows\.env (git-ignored) and fill in. Placeholders only: never commit real values.
# Guide: docs/guides/WINDOWS_DOCKER_DESKTOP.md. Validate with:  .\scripts\windows\helpdesk.ps1 check

# --- Isolation from other Docker applications on this PC (for example the SAMH Asset Management Suite) ---
# A project name of your own (NOT "helpdesk": that is the local development stack). It names every volume and network: helpdesk-win_pgdata, helpdesk-win_internal ...
COMPOSE_PROJECT_NAME=helpdesk-win
# A private subnet no other Docker network uses (the check lists conflicts) and the address Nginx gets inside it.
INTERNAL_SUBNET=172.31.77.0/24
PROXY_IP=172.31.77.10
# Ports published on this PC. The check refuses ports that are already in use. If HTTPS_PORT is not 443, set PUBLIC_PORT_SUFFIX to ":<port>" (the check enforces it).
# Which interface publishes the proxy. 127.0.0.1 keeps it private to this PC (the safe default); use the PC's LAN address or 0.0.0.0 only when colleagues must reach it.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443
PUBLIC_PORT_SUFFIX=:8443

# --- Address users type. A name that resolves on your network (the PC name, e.g. helpdesk-pc, or a DNS/hosts entry). No public domain is needed ---
PUBLIC_HOST=helpdesk-pc
# Folder with fullchain.pem and privkey.pem (git-ignored). Relative paths are relative to docker\production. Create a LAN certificate with: helpdesk.ps1 new-certificate
TLS_DIR=../windows/tls

# --- PostgreSQL (volume <project>_pgdata inside Docker Desktop; the Data Protection key ring lives in this database) ---
POSTGRES_PASSWORD=

# --- Microsoft Entra ID sign-in: an app registration whose redirect URI is https://<PUBLIC_HOST><PUBLIC_PORT_SUFFIX>/api/auth/signin-oidc ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
BOOTSTRAP_PLATFORM_ADMIN_SUBJECT=

# --- Microsoft Graph (shared mailboxes). Test tenant or real mailboxes: see docs/guides/GRAPH_TENANT_VALIDATION.md section 1 ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Object storage. With no S3 provider, keep LOCAL_OBJECT_STORE=true: a private SeaweedFS runs inside this project and S3_ENDPOINT is http://objectstore:8333 ---
LOCAL_OBJECT_STORE=true
S3_ENDPOINT=http://objectstore:8333
S3_BUCKET=helpdesk-win
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Image tag (use the commit id) ---
HELPDESK_VERSION=windows

# --- Backups (used by helpdesk.ps1 backup / backup-schedule) ---
# An absolute folder, ideally on ANOTHER drive or a network share (a backup on the same disk does not survive the disk). The passphrase is NOT stored here.
BACKUP_DIR=D:\HelpdeskBackups
# Retention: keep every backup newer than BACKUP_KEEP_DAYS, but never fewer than BACKUP_MIN_KEEP newest ones.
BACKUP_KEEP_DAYS=14
BACKUP_MIN_KEEP=24
# Optional: a program or script called with the failure message as its only argument (mail, chat webhook ...).
BACKUP_ALERT_COMMAND=
# Private validation only: NO_EGRESS=true puts the application, database and object store on a network with no route to the internet (no Microsoft 365 calls possible).
# Leave empty for a real deployment.
NO_EGRESS=
# --- Data Protection key ring encryption at rest (optional until approved; see docs/guides/PRODUCTION_DEPLOYMENT.md) ---
# In-container paths of a PFX and a file holding its password, mounted read-only from outside the repository (never commit them).
DP_CERT_PATH=
DP_CERT_PASSWORD_FILE=
# true makes the host refuse to start without DP_CERT_PATH.
DP_REQUIRE_CERT=false
