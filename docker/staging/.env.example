# STAGING environment. Copy to docker/staging/.env (git-ignored) and fill in. Placeholders only: never commit real values, never reuse a production secret here.
# Staging runs the production topology (docker/production/compose.yml) under its OWN project name, volumes, network and secrets, against a TEST Entra
# registration, a TEST Microsoft 365 tenant/mailboxes and a SEPARATE storage bucket. See docs/guides/STAGING_DEPLOYMENT.md.

# --- Isolation (do not change the project name; scripts/ops/staging.sh enforces it) ---
COMPOSE_PROJECT_NAME=helpdesk-staging
# Network and ports. Defaults suit a dedicated staging host. On a host that also runs production or development, pick a free subnet and ports instead.
INTERNAL_SUBNET=172.30.0.0/24
PROXY_IP=172.30.0.10
HTTP_PORT=80
HTTPS_PORT=443
# Directory holding fullchain.pem and privkey.pem (git-ignored). Relative paths are relative to docker/production/.
TLS_DIR=../staging/tls

# --- Public address (must resolve to this host; the certificate must cover it) ---
PUBLIC_HOST=helpdesk-staging.example.org

# --- PostgreSQL (container volume <project>_pgdata; the application's Data Protection key ring lives in this database) ---
POSTGRES_PASSWORD=

# --- Microsoft Entra ID sign-in: a TEST app registration (redirect URI https://<PUBLIC_HOST>/signin-oidc, single tenant) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Object id (oid) of the first Platform Admin; that identity becomes Platform Admin at first sign-in.
BOOTSTRAP_PLATFORM_ADMIN_SUBJECT=

# --- Microsoft Graph (shared mailboxes): a TEST app registration scoped to test mailboxes only (docs/guides/GRAPH_TENANT_VALIDATION.md section 1) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Object storage (S3-compatible; a staging-only bucket and key). Attachments are disabled in this topology until a scanner exists, so it stays empty ---
S3_ENDPOINT=
S3_BUCKET=helpdesk-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Image tag built for this deployment (use the commit id, e.g. e28e912) ---
HELPDESK_VERSION=staging
