# Backup environment for the STAGING scheduler. Install as /etc/helpdesk-staging/backup.env (mode 0600, owned by the backup user). Never in the repository.
# Read by scripts/ops/backup-all.sh through the systemd units helpdesk-staging-backup.service/.timer (docs/guides/STAGING_DEPLOYMENT.md).

# Which compose project the backup scripts talk to. These three lines are what keep staging backups from touching any other environment.
COMPOSE_PROJECT_NAME=helpdesk-staging
COMPOSE_FILE=/opt/helpdesk/docker/production/compose.yml
ENV_FILE=/opt/helpdesk/docker/staging/.env

# Encryption: a file holding a long random passphrase (for example `openssl rand -base64 48 > /etc/helpdesk-staging/backup.pass; chmod 600`).
# Keep a second copy somewhere that survives the loss of this host; without it the backups cannot be restored.
BACKUP_PASSPHRASE_FILE=/etc/helpdesk-staging/backup.pass
# Staging directory for encrypted dumps; mount or sync it to storage OFF this host.
BACKUP_DIR=/var/backups/helpdesk-staging
BACKUP_STATUS_FILE=/var/backups/helpdesk-staging/last-backup.json
# Optional: an executable called with the failure message as its only argument (mail, chat webhook, pager).
# BACKUP_ALERT_COMMAND=/usr/local/bin/helpdesk-alert

# Optional object-store copy (only useful if attachments are ever enabled). Needs the AWS CLI on this host.
# OBJECT_BACKUP_DEST=s3://offhost-staging-bucket/helpdesk-objects
# OBJECT_BACKUP_SSE=AES256
# S3_ENDPOINT=
# S3_BUCKET=helpdesk-staging
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
