{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "Database": { "ConnectionString": "", "MigrateOnStartup": false },
  "Authentication": {
    "Entra": { "TenantId": "", "ClientId": "", "ClientSecret": "" },
    "DevSignIn": { "Enabled": false },
    "BootstrapPlatformAdminSubjects": []
  },
  "Mail": {
    "Provider": "Graph",
    "NotificationBaseUrl": "",
    "SubscriptionLifetimeDays": 3,
    "Graph": { "TenantId": "", "ClientId": "", "ClientSecret": "", "CertificatePath": "" }
  },
  "Storage": {
    "Provider": "S3",
    "S3": { "Endpoint": "", "Bucket": "helpdesk", "Region": "us-east-1", "AccessKey": "", "SecretKey": "", "ForcePathStyle": true }
  },
  "Attachments": { "MaxBytes": 26214400, "RequireCleanScan": true },
  "Jobs": { "Enabled": true },
  "Proxy": { "KnownProxies": [] }
}
