# Copy to .env for local Docker Compose. Placeholders only; never commit real secrets.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev
POSTGRES_PORT=5432
S3_ACCESS_KEY=helpdesk-local
S3_SECRET_KEY=change-me-local-only
S3_PORT=8333

# --- Production mode (dev.ps1 prod-*; profile production). Leave empty for Development. Real values go ONLY in the git-ignored .env. ---
# Separate database on the same server; must differ from POSTGRES_DB (the development database is never used by Production).
PROD_DB_NAME=helpdesk_prod
# Public host name behind Cloudflare Access (the only host the app accepts).
PUBLIC_HOST=helpdesk.amb-it.co.uk
# Networks the reverse proxy (cloudflared) connects from; forwarded client-address headers are trusted from nothing else. Default 172.16.0.0/12 (private Docker ranges);
# narrow to the exact compose subnet where the host allows (docs/guides/CLIENT_ADDRESS_AND_RATE_LIMITS.md). One CIDR.
PROXY_KNOWN_NETWORKS=172.16.0.0/12
S3_BUCKET=helpdesk
# Production object store (own SeaweedFS and volume, internal only). Distinct from the development S3_* keys; generate long random values.
PROD_S3_ACCESS_KEY=
PROD_S3_SECRET_KEY=
# Entra OIDC sign-in app registration (redirect URI https://<PUBLIC_HOST>/api/auth/signin-oidc) and the first platform admin Entra object id.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
BOOTSTRAP_PLATFORM_ADMIN_SUBJECT=
# Microsoft Graph (shared mailboxes): a certificate is preferred over a secret.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_CERT_PATH=
GRAPH_CERT_PASSWORD=
# A folder OUTSIDE the repository holding the PFX and password files; mounted read-only at /run/helpdesk-secrets.
SECRETS_DIR=
# Data Protection key-ring certificate (in-container paths under /run/helpdesk-secrets). Production always requires it.
DP_CERT_PATH=
DP_CERT_PASSWORD_FILE=

# Operator tooling (non-secret). Used by scripts/windows/set-tunnel-token.ps1 and check-graph-mailbox-access.ps1.
CLOUDFLARE_TUNNEL_ID=
GRAPH_CHECK_MAILBOXES=

# Production PostgreSQL (service postgres-prod, own volume). Administrator role: migrations and restore. Application role: least privilege (DML only).
PROD_PG_ADMIN_USER=helpdesk_prod_admin
PROD_PG_ADMIN_PASSWORD=
PROD_APP_DB_USER=helpdesk_app
PROD_APP_DB_PASSWORD=
