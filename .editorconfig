root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,ts,tsx,js,css,html,md}]
indent_size = 2

[tests/**.cs]
# Descriptive snake_case test names are intentional
dotnet_diagnostic.CA1707.severity = none
